# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Configuration
# NOTE: Admin access is managed via the admin_users table in Supabase.
# After running the schema.sql, add your admin email with:
# INSERT INTO admin_users (email) VALUES ('your-email@example.com');

# Google reCAPTCHA v2
# Get your keys from: https://www.google.com/recaptcha/admin
# Site key: Public key for client-side widget (safe to expose)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Secret key: Private key for server-side verification (NEVER expose to client)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Formspree Configuration
# Get your endpoint from: https://formspree.io/
# Format: https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Optional: For production
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
