# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin Configuration
# NOTE: Admin access is managed via the admin_users table in Supabase.
# After running the schema.sql, add your admin email with:
# INSERT INTO admin_users (email) VALUES ('your-email@example.com');

# Google reCAPTCHA v2
# Get your keys from: https://www.google.com/recaptcha/admin
# Site key: Public key for client-side widget (safe to expose)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Secret key: Private key for server-side verification (NEVER expose to client)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Formspree Configuration
# Get your endpoint from: https://formspree.io/
# Format: https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Site URL Configuration
# REQUIRED in production for CORS security
# Format: https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Vercel KV Configuration (Required for Production)
# Get these from: Vercel Dashboard > Storage > KV
# These enable distributed rate limiting and CSRF protection
KV_REST_API_URL=your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-rest-api-token
KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token

# Session Timeout Configuration (Optional)
# Session timeout in minutes (default: 10)
SESSION_TIMEOUT_MINUTES=10

# CSP Nonce Configuration (Optional)
# Enable nonce-based Content Security Policy for stronger XSS protection
# Set to 'true' to enable (requires updating scripts to use nonces)
NEXT_PUBLIC_CSP_NONCE_ENABLED=false

# Optional: For production
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
