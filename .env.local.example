# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# ⚠️ IMPORTANT: Use the "anon public" key here (starts with eyJ...)
# NOT the service_role key (which starts with sb_secret_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for OAuth callbacks and unsubscribe links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google reCAPTCHA v2
# Get your keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Formspree (Contact Form)
# Get your endpoint from: https://formspree.io
# Sign up (free tier: 50 submissions/month) and create a new form
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Vercel KV (REQUIRED for production - distributed rate limiting & CSRF)
# Get from: Vercel Dashboard > Storage > KV
# Uncomment and fill in for production deployment:
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=your-kv-token
# KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token

# Email Notifications (Resend API - Optional but recommended)
# Get API key from: https://resend.com/api-keys
# Uncomment to enable email notification features:
# RESEND_API_KEY=re_your_api_key_here
# FROM_EMAIL=noreply@yourdomain.com
# UNSUBSCRIBE_TOKEN_SECRET=your_long_random_secret_here_min_32_chars

# Generate unsubscribe secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Optional: Service role key for server-side admin operations (NEVER expose to client!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Session timeout configuration
# SESSION_TIMEOUT_MINUTES=10

# Optional: Enable nonce-based CSP (advanced security)
# NEXT_PUBLIC_CSP_NONCE_ENABLED=false
